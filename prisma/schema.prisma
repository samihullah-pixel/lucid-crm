generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum BillingType {
  PAUSCHAL
  STUNDENSATZ
}
enum IntervalType {
  EINMALIG
  TAEGLICH
  WOECHENTLICH
  ZWEIWOECHENTLICH
  MONATLICH
  NACH_BEDARF
}
enum AppointmentStatus {
  AKTIV
  PAUSIERT
}
enum CleaningJobStatus {
  GEPLANT
  ERLEDIGT
  VERSCHOBEN
  STORNIERT
}
enum ServiceType {
  UNTERHALTSREINIGUNG
  FENSTERREINIGUNG
  TREPPENHAUSREINIGUNG
  GRUNDREINIGUNG
  SONDERREINIGUNG
  BAUENDREINIGUNG
  DESINFEKTION
  SONSTIGES
}
enum ExtraBillingType {
  STUNDENSATZ
  PAUSCHAL
}
enum MaterialProvider {
  DU
  KUNDE
  GEMISCHT
  EXTERN
}
enum MaterialBillingType {
  INKLUSIVE
  PAUSCHALE
  NACH_VERBRAUCH
  SEPARAT
}
enum InvoiceStatus {
  ENTWURF
  ERSTELLT
  VERSENDET
  BEZAHLT
  STORNIERT
}
enum InvoiceItemType {
  REGELLEISTUNG
  ZUSATZARBEIT
  MATERIALPAUSCHALE
  VERBRAUCHSMATERIAL
  SERVICEPAUSCHALE
  SONSTIGES
}
model Employee {
  id               String            @id @default(cuid())
  firstName        String
  lastName         String
  email            String?
  phone            String?
  color            String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  appointments     Appointment[]
  cleaningJobs     CleaningJob[]
  shiftAssignments    ShiftAssignment[]
  inspectionProtocols InspectionProtocol[]
  workLogEntries      WorkLogEntry[]
  supplyOrders        SupplyOrder[]
}

model Site {
  id        String   @id @default(cuid())
  name      String
  shortName String
  color     String?
  address   String?
  notes     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shifts              Shift[]
  inspectionTemplates InspectionTemplate[]
  inspectionProtocols InspectionProtocol[]
  workLogs            WorkLog[]
  siteProcedures      SiteProcedure[]
}

enum StepMediaType {
  NONE
  PHOTO
  VIDEO
}

// A reusable, generic cleaning procedure (e.g. "Bus-Innenreinigung").
// Acts as the master template; sites adopt it via SiteProcedure.
model Procedure {
  id          String               @id @default(cuid())
  name        String
  serviceType ServiceType?
  description String?
  translations Json?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  steps       ProcedureStep[]
  equipment   ProcedureEquipment[]
  sites       SiteProcedure[]
}

// One step in a procedure, shown one-per-screen on mobile.
model ProcedureStep {
  id            String        @id @default(cuid())
  procedureId   String
  procedure     Procedure     @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  section       String?
  title         String
  body          String?
  mediaUrl      String?
  mediaType     StepMediaType @default(NONE)
  tip           String?
  warning       String?
  translations  Json?
  requiresCheck Boolean       @default(false)
  order         Int           @default(0)
  @@index([procedureId])
}

// Reusable equipment/material definition with photo and default location.
model EquipmentItem {
  id              String               @id @default(cuid())
  name            String
  iconKey         String?
  imageUrl        String?
  defaultLocation String?
  translations    Json?
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  procedures      ProcedureEquipment[]
}

// Which equipment a procedure needs, with an optional location override.
model ProcedureEquipment {
  id           String        @id @default(cuid())
  procedureId  String
  procedure    Procedure     @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  equipmentId  String
  equipment    EquipmentItem @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  locationNote String?
  order        Int           @default(0)
  @@unique([procedureId, equipmentId])
  @@index([procedureId])
  @@index([equipmentId])
}

// A site adopting a procedure. The QR code encodes qrToken and opens the
// public, login-free guide; local fields override generic content.
model SiteProcedure {
  id            String    @id @default(cuid())
  siteId        String
  site          Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  procedureId   String
  procedure     Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  qrToken       String    @unique @default(cuid())
  welcomeText   String?
  waterLocation String?
  accessNote    String?
  emergencyNote String?
  translations  Json?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@unique([siteId, procedureId])
  @@index([siteId])
  @@index([procedureId])
}

model Shift {
  id            String            @id @default(cuid())
  siteId        String
  name          String
  startTime     String
  endTime       String
  requiredStaff Int               @default(1)
  weekdays      Int[]             @default([1, 2, 3, 4, 5])
  validFrom     DateTime
  validUntil    DateTime?
  sortOrder     Int               @default(0)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  site          Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assignments   ShiftAssignment[]
  @@index([siteId])
}

model ShiftAssignment {
  id         String   @id @default(cuid())
  shiftId    String
  employeeId String
  date       DateTime
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  shift      Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@unique([shiftId, employeeId, date])
  @@index([shiftId])
  @@index([employeeId])
  @@index([date])
}
model Customer {
  id                String              @id @default(cuid())
  customerNumber    String              @unique
  companyName       String
  contactPerson     String?
  email             String?
  phone             String?
  billingAddress    String?
  postalCode        String?
  city              String?
  paymentTermsDays  Int?                @default(14)
  vatId             String?
  notes             String?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  properties        Property[]
  serviceContracts  ServiceContract[]
  cleaningJobs      CleaningJob[]
  extraWorks        ExtraWork[]
  invoices          Invoice[]
  materialPlans       MaterialAgreement[]
  supplyItems         CustomerSupplyItem[]
  supplyOrderItems    SupplyOrderItem[]
}
model Property {
  id                   String               @id @default(cuid())
  customerId           String
  name                 String
  address              String
  postalCode           String?
  city                 String?
  contactOnSite        String?
  phoneOnSite          String?
  accessType           String?
  accessDetails        String?
  keyNumber            String?
  hasAlarmSystem       Boolean              @default(false)
  alarmNote            String?
  accessTimes          String?
  parkingInfo          String?
  hasElevator          Boolean              @default(false)
  floor                String?
  specialAreas         String?
  safetyInstructions   String?
  roomList             String?
  notes                String?
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  customer             Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceContracts     ServiceContract[]
  appointments         Appointment[]
  cleaningJobs         CleaningJob[]
  extraWorks           ExtraWork[]
  invoices             Invoice[]
  materialAgreements   MaterialAgreement[]
  inspectionTemplates  InspectionTemplate[]
  subcontractRequests  SubcontractRequest[]
  supplyOrders         SupplyOrder[]
  @@index([customerId])
}
model ServiceContract {
  id                  String          @id @default(cuid())
  customerId          String
  propertyId          String
  title               String
  serviceType         ServiceType
  billingType         BillingType
  flatRatePrice       Decimal?        @db.Decimal(10, 2)
  hourlyRate          Decimal?        @db.Decimal(10, 2)
  serviceDescription  String?
  intervalType        IntervalType
  weekdays            String?
  standardHours       Decimal?        @db.Decimal(5, 2)
  contractStart       DateTime
  contractEnd         DateTime?
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  customer            Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  property            Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  appointments        Appointment[]
  @@index([customerId])
  @@index([propertyId])
}
model Appointment {
  id                 String              @id @default(cuid())
  propertyId         String
  serviceContractId  String?
  employeeId         String?
  title              String
  date               DateTime?
  intervalType       IntervalType
  weekdays           Int[]               @default([])
  startDate          DateTime?
  startTime          String?
  endTime            String?
  standardHours      Decimal?            @db.Decimal(5, 2)
  status             AppointmentStatus   @default(AKTIV)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  property           Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  serviceContract    ServiceContract?    @relation(fields: [serviceContractId], references: [id], onDelete: SetNull)
  employee           Employee?           @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  cleaningJobs       CleaningJob[]
  subcontractRequests SubcontractRequest[]
  @@index([propertyId])
  @@index([serviceContractId])
  @@index([employeeId])
}
model CleaningJob {
  id                 String              @id @default(cuid())
  customerId         String
  propertyId         String
  appointmentId      String?
  employeeId         String?
  date               DateTime
  startTime          String?
  endTime            String?
  workedHours        Decimal?            @db.Decimal(5, 2)
  serviceType        ServiceType
  note               String?
  status             CleaningJobStatus   @default(GEPLANT)
  billable           Boolean             @default(true)
  alreadyInvoiced    Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  property           Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  appointment        Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  employee           Employee?           @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  extraWorks         ExtraWork[]
  @@index([customerId])
  @@index([propertyId])
  @@index([appointmentId])
  @@index([employeeId])
  @@index([date])
}
model ExtraWork {
  id                   String            @id @default(cuid())
  customerId           String
  propertyId           String
  cleaningJobId        String?
  date                 DateTime
  description          String
  billingType          ExtraBillingType
  hours                Decimal?          @db.Decimal(5, 2)
  hourlyRate           Decimal?          @db.Decimal(10, 2)
  flatRatePrice        Decimal?          @db.Decimal(10, 2)
  customerApproved     Boolean           @default(false)
  billable             Boolean           @default(true)
  alreadyInvoiced      Boolean           @default(false)
  invoiceId            String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  customer             Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  property             Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  cleaningJob          CleaningJob?      @relation(fields: [cleaningJobId], references: [id], onDelete: SetNull)
  invoice              Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  @@index([customerId])
  @@index([propertyId])
  @@index([cleaningJobId])
  @@index([invoiceId])
  @@index([date])
}
model MaterialAgreement {
  id                        String              @id @default(cuid())
  customerId                String
  propertyId                String
  materialProvider          MaterialProvider
  cleaningSuppliesProvider  MaterialProvider
  consumablesProvider       MaterialProvider
  clothServiceProvider      MaterialProvider
  mopServiceProvider        MaterialProvider
  materialBillingType       MaterialBillingType
  cleaningMaterialFlatRate  Decimal?            @db.Decimal(10, 2)
  serviceFlatRate           Decimal?            @db.Decimal(10, 2)
  materialNotes             String?
  storageLocation           String?
  minimumStockNote          String?
  orderInterval             IntervalType?
  lastOrderDate             DateTime?
  nextOrderDate             DateTime?
  clothWashInterval         IntervalType?
  mopWashInterval           IntervalType?
  clothReplacementInterval  IntervalType?
  mopReplacementInterval    IntervalType?
  lastMaintenanceDate       DateTime?
  isActive                  Boolean             @default(true)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  customer                  Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  property                  Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  materialItems             MaterialItem[]
  @@index([customerId])
  @@index([propertyId])
}
model MaterialItem {
  id                   String             @id @default(cuid())
  materialAgreementId  String
  name                 String
  category             String
  unit                 String?
  standardQuantity     Decimal?           @db.Decimal(10, 2)
  minimumStock         Decimal?           @db.Decimal(10, 2)
  reorderQuantity      Decimal?           @db.Decimal(10, 2)
  supplier             String?
  unitPrice            Decimal?           @db.Decimal(10, 2)
  billable             Boolean            @default(false)
  includedInFlatRate   Boolean            @default(true)
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  materialAgreement    MaterialAgreement  @relation(fields: [materialAgreementId], references: [id], onDelete: Cascade)
  @@index([materialAgreementId])
}
model Invoice {
  id                 String         @id @default(cuid())
  customerId         String
  propertyId         String?
  invoiceNumber      String         @unique
  invoiceDate        DateTime
  servicePeriodFrom  DateTime
  servicePeriodTo    DateTime
  netAmount          Decimal        @db.Decimal(10, 2)
  taxRate            Decimal        @db.Decimal(5, 2)
  taxAmount          Decimal        @db.Decimal(10, 2)
  grossAmount        Decimal        @db.Decimal(10, 2)
  status             InvoiceStatus  @default(ENTWURF)
  qontoExported      Boolean        @default(false)
  pdfPath            String?
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  customer           Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  property           Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  extraWorks         ExtraWork[]
  items              InvoiceItem[]
  supplyOrderItems   SupplyOrderItem[]
  @@index([customerId])
  @@index([propertyId])
  @@index([invoiceDate])
}
enum InspectionStatus {
  OFFEN
  IN_BEARBEITUNG
  ABGESCHLOSSEN
}

model InspectionTemplate {
  id          String               @id @default(cuid())
  name        String
  propertyId  String?
  siteId      String?
  property    Property?            @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  site        Site?                @relation(fields: [siteId], references: [id], onDelete: SetNull)
  areas       InspectionArea[]
  protocols   InspectionProtocol[]
  workLogs    WorkLog[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  @@index([propertyId])
  @@index([siteId])
}

model InspectionProtocol {
  id          String           @id @default(cuid())
  templateId  String
  siteId      String?
  employeeId  String?
  weekStart   DateTime
  status      InspectionStatus @default(OFFEN)
  completedAt DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  template    InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  site        Site?              @relation(fields: [siteId], references: [id], onDelete: SetNull)
  employee    Employee?          @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  checks      InspectionCheck[]
  @@unique([templateId, weekStart])
  @@index([templateId])
  @@index([siteId])
  @@index([employeeId])
  @@index([weekStart])
}

model InspectionCheck {
  id         String              @id @default(cuid())
  protocolId String
  areaName   String
  itemLabel  String
  checked    Boolean             @default(false)
  rating     Int?
  note       String?
  checkedAt  DateTime?
  sortOrder  Int                 @default(0)
  protocol   InspectionProtocol  @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  @@index([protocolId])
}

model InspectionArea {
  id          String             @id @default(cuid())
  templateId  String
  template    InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name        String
  order       Int                @default(0)
  items       InspectionItem[]
  @@index([templateId])
}

model InspectionItem {
  id              String         @id @default(cuid())
  areaId          String
  area            InspectionArea @relation(fields: [areaId], references: [id], onDelete: Cascade)
  label           String
  interval        String         @default("TAEGLICH")
  durationMinutes Int?
  order           Int            @default(0)
  @@index([areaId])
}

model Supplier {
  id             String        @id @default(cuid())
  name           String
  email          String
  phone          String?
  // Unsere eigene Kundennummer BEI diesem Lieferanten – gehört in jede Bestell-Mail.
  customerNumber String?
  // Optionale Standard-CC-Adresse, die beim Bestellen vorausgefüllt wird (z.B. Buchhaltung).
  defaultCc      String?
  notes          String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  products       Product[]
  orders         SupplyOrder[]
}

model Product {
  id          String               @id @default(cuid())
  name        String
  unit        String?
  unitPrice   Decimal              @db.Decimal(10, 2)
  imageUrl    String?
  supplierId  String
  supplier    Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  items       CustomerSupplyItem[]
  orderItems  SupplyOrderItem[]
  @@index([supplierId])
}

model CustomerSupplyItem {
  id            String    @id @default(cuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int
  intervalDays  Int
  lastOrderedAt DateTime?
  nextDueAt     DateTime
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@index([customerId])
  @@index([productId])
}

enum SupplyOrderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// AUTO  = vom Cron (Verbrauchsplanung) ausgelöst.
// MANUAL = von einem Mitarbeiter über die App selbst ausgelöst.
enum SupplyOrderSource {
  AUTO
  MANUAL
}

model SupplyOrder {
  id         String            @id @default(cuid())
  supplierId String
  supplier   Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status     SupplyOrderStatus @default(PENDING)
  source     SupplyOrderSource @default(AUTO)
  // Lieferobjekt der manuellen Bestellung (bestimmt Lieferadresse + Kunde).
  propertyId String?
  property   Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  // Mitarbeiter, der die Bestellung ausgelöst hat (Nachvollziehbarkeit).
  employeeId String?
  employee   Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  ccEmail    String?
  note       String?
  sentAt     DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  items      SupplyOrderItem[]
  @@index([supplierId])
  @@index([propertyId])
  @@index([employeeId])
}

model SupplyOrderItem {
  id         String      @id @default(cuid())
  orderId    String
  order      SupplyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int
  unitPrice  Decimal     @db.Decimal(10, 2)
  billed     Boolean     @default(false)
  invoiceId  String?
  invoice    Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())
  @@index([orderId])
  @@index([customerId])
  @@index([invoiceId])
}

model InvoiceItem {
  id            String          @id @default(cuid())
  invoiceId     String
  type          InvoiceItemType
  description   String
  quantity      Decimal?        @db.Decimal(10, 2)
  unit          String?
  unitPrice     Decimal?        @db.Decimal(10, 2)
  totalPrice    Decimal         @db.Decimal(10, 2)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  invoice       Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  @@index([invoiceId])
}

enum WorkLogStatus {
  OFFEN
  ABGESCHLOSSEN
}

model WorkLog {
  id         String             @id @default(cuid())
  templateId String
  template   InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  siteId     String
  site       Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  date       DateTime           @db.Date
  status     WorkLogStatus      @default(OFFEN)
  completedAt DateTime?
  notes      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  entries    WorkLogEntry[]
  @@unique([templateId, date])
  @@index([siteId])
  @@index([date])
}

model WorkLogEntry {
  id         String    @id @default(cuid())
  workLogId  String
  workLog    WorkLog   @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  areaName   String
  itemLabel  String
  checked    Boolean   @default(false)
  checkedAt  DateTime?
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  sortOrder  Int       @default(0)
  @@index([workLogId])
  @@index([employeeId])
}

enum SubcontractStatus {
  ANGEFRAGT
  TERMIN_VORGESCHLAGEN
  BESTAETIGT
  ABGELEHNT
  STORNIERT
}

model Partner {
  id            String               @id @default(cuid())
  name          String
  contactPerson String?
  email         String
  phone         String?
  serviceArea   String?
  notes         String?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  requests      SubcontractRequest[]
}

model SubcontractRequest {
  id                 String            @id @default(cuid())
  appointmentId      String?
  partnerId          String
  propertyId         String
  serviceDescription String
  requestedDate      DateTime
  proposedDate       DateTime?
  status             SubcontractStatus @default(ANGEFRAGT)
  confirmToken       String            @unique
  partnerPrice       Decimal           @db.Decimal(10, 2)
  partnerNote        String?
  customerPrice      Decimal?          @db.Decimal(10, 2)
  requestedAt        DateTime          @default(now())
  respondedAt        DateTime?
  customerNotifiedAt DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  appointment        Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  partner            Partner           @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  property           Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  @@index([partnerId])
  @@index([propertyId])
  @@index([appointmentId])
  @@index([status])
}
